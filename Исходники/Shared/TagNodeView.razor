@* Рекурсивный узел дерева тегов: иконки по виду и типу данных, счётчики, подсветка новых *@
@using System.Text.RegularExpressions

<div class="tag-row @(IsSelected ? "selected" : "") @(IsNew ? "is-new" : "") @(IsKbFocus ? "kb-focus" : "")"
     @onclick="Select" @onclick:stopPropagation="true" @ondblclick="OpenTab" @ondblclick:stopPropagation="true">
    <span class="twisty" @onclick="Toggle" @onclick:stopPropagation="true">
        @if (!Node.IsLeaf) { @(Expanded ? "▾" : "▸") }
    </span>
    <span class="kind">@KindIcon</span>
    <span class="tag-name">@Node.Name</span>
    @if (Node.Kind is NodeKind.Array or NodeKind.Struct && Node.ElementCount > 0)
    {
        <span class="tag-count">@Node.ElementCount</span>
    }
    @if (!string.IsNullOrEmpty(Node.TypeName)) { <span class="tag-type">: @Node.TypeName</span> }
    @if (!string.IsNullOrEmpty(Node.Address)) { <span class="tag-addr">[@Node.Address]</span> }
    @if (IsNew) { <span class="new-badge">new</span> }
    @if (!string.IsNullOrEmpty(Node.Comment)) { <span class="tag-comment">@FirstCommentLine</span> }
</div>

@if (!Node.IsLeaf && Expanded)
{
    <div class="tag-children">
        @foreach (var child in Node.Children)
        {
            if (Parent.Matches(child))
            {
                <TagNodeView @key="child.FullPath" Node="@child" Parent="@Parent" Depth="@(Depth + 1)" />
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public TagNode Node { get; set; } = default!;
    [Parameter, EditorRequired] public Pages.Home Parent { get; set; } = default!;
    [Parameter] public int Depth { get; set; }

    private bool IsSelected => ReferenceEquals(Parent.SelectedNode, Node);
    private bool IsKbFocus => ReferenceEquals(Parent.KeyboardNode, Node);
    private bool IsNew => Parent.IsNewTag(Node);

    private bool Expanded =>
        Parent.IsExpanded(Node)
        || (!string.IsNullOrEmpty(Parent.Filter) && Node.Children.Any(c => Parent.Matches(c)));

    private string FirstCommentLine =>
        Node.Comment.Split('\n')[0];

    private void Toggle()
    {
        Parent.ToggleExpanded(Node);
        Parent.Refresh();
    }

    private void Select()
    {
        Parent.SelectedNode = Node;
        Parent.KeyboardNode = Node;
        if (!Node.IsLeaf) Parent.ToggleExpanded(Node);
        Parent.Refresh();
    }

    private void OpenTab() => Parent.OpenTabFor(Node);

    private enum TypeCat { Other, Bool, Int, Real, String, Time }

    /// <summary>Категория типа: для массивов — по базовому типу элементов.</summary>
    private static TypeCat CatOf(string typeName)
    {
        if (string.IsNullOrEmpty(typeName)) return TypeCat.Other;
        var t = typeName.Trim();
        var m = Regex.Match(t, @"OF\s+(.+)$", RegexOptions.IgnoreCase);
        if (m.Success) t = m.Groups[1].Value.Trim(); // ARRAY[..] OF X → X
        if (Regex.IsMatch(t, @"^(BOOL|SAFEBOOL|BIT)$", RegexOptions.IgnoreCase)) return TypeCat.Bool;
        if (Regex.IsMatch(t, @"^(U?S?INT|U?DINT|U?LINT|BYTE|WORD|DWORD|LWORD|SINT|USINT|UINT|UDINT|ULINT)$", RegexOptions.IgnoreCase)) return TypeCat.Int;
        if (Regex.IsMatch(t, @"^(REAL|LREAL)$", RegexOptions.IgnoreCase)) return TypeCat.Real;
        if (Regex.IsMatch(t, @"^(STRING|WSTRING|CHAR|WCHAR)$", RegexOptions.IgnoreCase)) return TypeCat.String;
        if (Regex.IsMatch(t, @"^(TIME|DATE|TIME_OF_DAY|TOD|DATE_AND_TIME|DT|LTIME)$", RegexOptions.IgnoreCase)) return TypeCat.Time;
        return TypeCat.Other;
    }

    private static string CatColor(TypeCat c) => c switch
    {
        TypeCat.Bool => "var(--c-bool)",
        TypeCat.Int => "var(--c-int)",
        TypeCat.Real => "var(--c-real)",
        TypeCat.String => "var(--c-string)",
        TypeCat.Time => "var(--c-time)",
        _ => "var(--text-soft)"
    };

    private RenderFragment KindIcon => builder =>
    {
        // Структуры и массивы сохраняют свои формы, но красятся по типу содержимого
        TypeCat cat = Node.Kind == NodeKind.Struct
            ? TypeCat.Other
            : CatOf(Node.TypeName);
        string stroke = Node.Kind switch
        {
            NodeKind.Struct => "var(--c-struct)",
            NodeKind.Array => CatColor(cat),
            NodeKind.ArrayItem => CatColor(cat),
            _ => CatColor(cat)
        };
        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "viewBox", "0 0 16 16");
        builder.AddAttribute(2, "fill", "none");
        builder.AddAttribute(3, "stroke", stroke);
        builder.AddAttribute(4, "stroke-width", "1.5");
        builder.AddAttribute(5, "stroke-linecap", "round");
        builder.AddAttribute(6, "stroke-linejoin", "round");
        switch (Node.Kind)
        {
            case NodeKind.Struct: // папка
                builder.OpenElement(7, "path");
                builder.AddAttribute(8, "d", "M2.5 5.5h4l1.5 1.5h5.5v5a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1V5.5z");
                builder.CloseElement();
                break;
            case NodeKind.Array: // скобки [ ]
                builder.OpenElement(7, "path");
                builder.AddAttribute(8, "d", "M5 2.5H3.5v11H5M11 2.5h1.5v11H11");
                builder.CloseElement();
                break;
            default:
                switch (cat)
                {
                    case TypeCat.Bool: // переключатель: квадрат + точка
                        builder.OpenElement(7, "rect");
                        builder.AddAttribute(8, "x", "4"); builder.AddAttribute(9, "y", "4");
                        builder.AddAttribute(10, "width", "8"); builder.AddAttribute(11, "height", "8");
                        builder.CloseElement();
                        builder.OpenElement(12, "circle");
                        builder.AddAttribute(13, "cx", "8"); builder.AddAttribute(14, "cy", "8"); builder.AddAttribute(15, "r", "1.6");
                        builder.AddAttribute(16, "fill", stroke); builder.AddAttribute(17, "stroke", "none");
                        builder.CloseElement();
                        break;
                    case TypeCat.Int: // решётка #
                        builder.OpenElement(7, "path");
                        builder.AddAttribute(8, "d", "M6 3.5v9M10 3.5v9M4 6.5h8M4 9.5h8");
                        builder.CloseElement();
                        break;
                    case TypeCat.Real: // цифра с точкой
                        builder.OpenElement(7, "path");
                        builder.AddAttribute(8, "d", "M4 11.5c1.5-5 3-7.5 4.2-7.5 1.4 0 1 3 .4 5.5M11 11.5h.01");
                        builder.CloseElement();
                        break;
                    case TypeCat.String: // кавычки
                        builder.OpenElement(7, "path");
                        builder.AddAttribute(8, "d", "M5.5 5.5c-1.2 1-2 2.5-2 4.5M8.5 5.5c-1.2 1-2 2.5-2 4.5M12 5.5c-1.2 1-2 2.5-2 4.5");
                        builder.CloseElement();
                        break;
                    case TypeCat.Time: // часы
                        builder.OpenElement(7, "circle");
                        builder.AddAttribute(8, "cx", "8"); builder.AddAttribute(9, "cy", "8"); builder.AddAttribute(10, "r", "5");
                        builder.CloseElement();
                        builder.OpenElement(12, "path");
                        builder.AddAttribute(13, "d", "M8 5.5V8l2 1.5");
                        builder.CloseElement();
                        break;
                    default: // круг
                        builder.OpenElement(7, "circle");
                        builder.AddAttribute(8, "cx", "8"); builder.AddAttribute(9, "cy", "8"); builder.AddAttribute(10, "r", "3");
                        builder.CloseElement();
                        break;
                }
                break;
        }
        builder.CloseElement();
    };
}
