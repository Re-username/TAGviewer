    private static string RuPlural(int n, string word)
    {
        return word switch
        {
            "файл" => n + Plural(n, " файл", " файла", " файлов"),
            "тег" => n + Plural(n, " тег", " тега", " тегов"),
            _ => n.ToString()
        };
    }

    private static string Plural(int n, string one, string few, string many)
    {
        int m = Math.Abs(n) % 100, d = m % 10;
        if (m > 10 && m < 20) return many;
        if (d > 1 && d < 5) return few;
        if (d == 1) return one;
        return many;
    }
}
